{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$comment": "JSON-RPC framing. Each root member is a message BODY: the library emits the envelope, picks the params/result/error key from Message::kind, and Message::method is free-form. Members are therefore named after the body shape, not the wire method.",
    "oneOf": [
        {
            "type": "object",
            "title": "color",
            "$comment": "body for the color request/response and the color_event notification; a colour is always raw XOR hsv",
            "oneOf": [
                { "$ref": "params/$defs/raw" },
                { "$ref": "params/$defs/hsv" }
            ]
        },
        {
            "$ref": "params/$defs/command-fields",
            "title": "command"
        },
        {
            "$ref": "params/$defs/command-request-fields",
            "title": "command_request"
        },
        {
            "type": "object",
            "title": "info",
            "oneOf": [
                { "$ref": "params/$defs/info-static-params" },
                { "$ref": "params/$defs/info-full-params" }
            ]
        },
        {
            "$ref": "params/$defs/runtime-info",
            "title": "runtime_info"
        },
        {
            "type": "object",
            "title": "networks",
            "oneOf": [
                { "$ref": "params/$defs/networks-params" }
            ]
        },
        {
            "type": "object",
            "title": "hosts",
            "oneOf": [
                { "$ref": "params/$defs/hosts-params" }
            ]
        },
        {
            "type": "object",
            "title": "connect",
            "oneOf": [
                { "$ref": "params/$defs/connect-result" }
            ]
        },
        {
            "$ref": "params/$defs/system-request",
            "title": "system_request"
        },
        {
            "$ref": "params/$defs/connect-request",
            "title": "connect_request"
        },
        {
            "$ref": "params/$defs/update-request",
            "title": "update_request"
        },
        {
            "$ref": "homeassistant/$defs/ha-channel-command",
            "title": "ha_channel_command"
        },
        {
            "$ref": "homeassistant/$defs/ha-command",
            "title": "ha_command"
        },
        {
            "$ref": "params/$defs/ws-request",
            "title": "ws_request"
        },
        {
            "$ref": "homeassistant/$defs/ha-state-color-temp",
            "title": "ha_state_color_temp"
        },
        {
            "$ref": "homeassistant/$defs/ha-state-hs",
            "title": "ha_state_hs"
        },
        {
            "$ref": "homeassistant/$defs/ha-channel-state",
            "title": "ha_channel_state"
        },
        {
            "$ref": "params/$defs/telemetry-params",
            "title": "telemetry"
        },
        {
            "$ref": "homeassistant/$defs/ha-discovery-main",
            "title": "ha_discovery_main"
        },
        {
            "$ref": "homeassistant/$defs/ha-discovery-channel",
            "title": "ha_discovery_channel"
        },
        {
            "$ref": "params/$defs/wifi-status",
            "title": "wifi_status"
        },
        {
            "$ref": "params/$defs/transition-finished",
            "title": "transition_finished"
        },
        {
            "$ref": "params/$defs/clock-slave-status",
            "title": "clock_slave_status"
        },
        {
            "$ref": "params/$defs/keep-alive",
            "title": "keep_alive"
        },
        {
            "$ref": "params/$defs/message-event",
            "title": "message_event"
        },
        {
            "$ref": "params/$defs/ota-status",
            "title": "ota_status"
        },
        {
            "$ref": "params/$defs/webapp-ota-status",
            "title": "webapp_ota_status"
        },
        {
            "$ref": "params/$defs/api-success",
            "title": "api_success"
        },
        {
            "$ref": "params/$defs/api-error",
            "title": "api_error"
        },
        {
            "$ref": "params/$defs/authenticate-result",
            "title": "authenticate_result"
        },
        {
            "$ref": "params/$defs/subscription-result",
            "title": "subscription_result"
        },
        {
            "$ref": "params/$defs/rpc-error",
            "title": "rpc_error"
        },
        {
            "type": "object",
            "title": "error",
            "$comment": "ReadStream resolves an error body via findObject(\"error\"); nests the shared value-types error-msg, which is only materialized in jsonrpc codegen",
            "properties": {
                "error": { "$ref": "value-types/$defs/error-msg" }
            }
        }
    ]
}