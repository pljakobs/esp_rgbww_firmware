{
  "$schema": "./api-manifest.schema.json",
  "name": "Lightinator API",
  "version": "1.0.0-inferred.1",
  "status": "inferred",
  "sources": {
    "firmware": ["app/webserver.cpp", "app/apihandler.cpp", "app/eventserver.cpp"],
    "frontend": ["../esp_rgb_webapp2/src/services/api.js", "../esp_rgb_webapp2/src/services/websocket.js"]
  },
  "schemas": {
    "wire": {
      "source": "schema/json-rpc-api.cfgdb",
      "projection": "json-rpc-api.schema.json",
      "database": "Api",
      "persistent": false
    },
    "config": {
      "source": "app-config.cfgdb",
      "projection": "schema/app-config.schema.json",
      "database": "AppConfig",
      "persistent": true
    },
    "data": {
      "source": "app-data.cfgdb",
      "projection": "schema/app-data.schema.json",
      "database": "AppData",
      "persistent": true
    },
    "definitions": {
      "source": "defs.cfgdb",
      "persistent": false
    },
    "http": {
      "source": "openapi.json",
      "persistent": false
    }
  },
  "http": {
    "security": "basicAuth",
    "operations": {
      "getConfig": { "method": "GET", "path": "/config", "result": "app-config.cfgdb#" },
      "updateConfig": { "method": "POST", "path": "/config", "params": "app-config.cfgdb#", "result": "#/definitions/apiSuccess" },
      "getInfo": { "method": "GET", "path": "/info", "result": "#/definitions/infoResult" },
      "getColor": { "method": "GET", "path": "/color", "result": "#/definitions/colorState" },
      "setColor": { "method": "POST", "path": "/color", "params": "#/definitions/colorParams", "result": "#/definitions/apiSuccess" },
      "getNetworks": { "method": "GET", "path": "/networks", "result": "#/definitions/networksResult" },
      "scanNetworks": { "method": "POST", "path": "/scan_networks", "result": "#/definitions/apiSuccess" },
      "getConnection": { "method": "GET", "path": "/connect", "result": "#/definitions/connectionResult" },
      "connect": { "method": "POST", "path": "/connect", "params": "#/definitions/connectParams", "result": "#/definitions/apiSuccess" },
      "system": { "method": "POST", "path": "/system", "params": "#/definitions/systemParams", "result": "#/definitions/apiSuccess" },
      "getUpdate": { "method": "GET", "path": "/update", "result": "#/definitions/updateStatus" },
      "startUpdate": { "method": "POST", "path": "/update", "params": "#/definitions/updateParams", "result": "#/definitions/apiSuccess" },
      "ping": { "method": "GET", "path": "/ping", "result": "#/definitions/pingResult" },
      "stop": { "method": "POST", "path": "/stop", "params": "#/definitions/animationParams", "result": "#/definitions/apiSuccess" },
      "skip": { "method": "POST", "path": "/skip", "params": "#/definitions/animationParams", "result": "#/definitions/apiSuccess" },
      "pause": { "method": "POST", "path": "/pause", "params": "#/definitions/animationParams", "result": "#/definitions/apiSuccess" },
      "continue": { "method": "POST", "path": "/continue", "params": "#/definitions/animationParams", "result": "#/definitions/apiSuccess" },
      "blink": { "method": "POST", "path": "/blink", "params": "#/definitions/blinkParams", "result": "#/definitions/apiSuccess" },
      "toggle": { "method": "POST", "path": "/toggle", "params": "#/definitions/animationParams", "result": "#/definitions/apiSuccess" },
      "setOn": { "method": "POST", "path": "/on", "params": "#/definitions/animationParams", "result": "#/definitions/apiSuccess" },
      "setOff": { "method": "POST", "path": "/off", "params": "#/definitions/animationParams", "result": "#/definitions/apiSuccess" },
      "getHosts": { "method": "GET", "path": "/hosts", "result": "#/definitions/hostsResult" },
      "getData": { "method": "GET", "path": "/data", "result": "app-data.cfgdb#" },
      "updateData": { "method": "POST", "path": "/data", "params": "app-data.cfgdb#", "result": "#/definitions/apiSuccess" },
      "getWebappStatus": { "method": "GET", "path": "/webapp_status", "result": "#/definitions/webappOtaStatusParams" },
      "getWebappCheck": { "method": "GET", "path": "/webapp_check", "result": "#/definitions/webappOtaStatusParams" },
      "checkWebapp": { "method": "POST", "path": "/webapp_check", "result": "#/definitions/webappOtaStatusParams" }
    }
  },
  "jsonRpc": {
    "url": "/ws",
    "version": "2.0",
    "methods": {
      "authenticate": { "params": "#/definitions/authenticateParams", "result": "#/definitions/authenticateResult", "authentication": false },
      "info": { "aliases": ["getInfo"], "params": "#/definitions/infoParams", "result": "#/definitions/infoResult" },
      "color": { "params": "#/definitions/colorParams", "result": "#/definitions/commandResult", "overload": { "emptyParamsResult": "#/definitions/colorState", "aliases": ["getColor"] } },
      "networks": { "aliases": ["getNetworks"], "params": "#/definitions/emptyParams", "result": "#/definitions/networksResult" },
      "stop": { "params": "#/definitions/animationParams", "result": "#/definitions/commandResult" },
      "skip": { "params": "#/definitions/animationParams", "result": "#/definitions/commandResult" },
      "pause": { "params": "#/definitions/animationParams", "result": "#/definitions/commandResult" },
      "continue": { "params": "#/definitions/animationParams", "result": "#/definitions/commandResult" },
      "blink": { "params": "#/definitions/blinkParams", "result": "#/definitions/commandResult" },
      "toggle": { "params": "#/definitions/animationParams", "result": "#/definitions/commandResult" },
      "direct": { "params": "#/definitions/animationParams", "result": "#/definitions/commandResult" },
      "setOn": { "aliases": ["on"], "params": "#/definitions/animationParams", "result": "#/definitions/commandResult" },
      "setOff": { "aliases": ["off"], "params": "#/definitions/animationParams", "result": "#/definitions/commandResult" },
      "keep_alive": { "params": "#/definitions/emptyParams", "result": "#/definitions/commandResult", "authentication": false },
      "scan_networks": { "params": "#/definitions/emptyParams", "result": "#/definitions/commandResult" },
      "system": { "params": "#/definitions/systemParams", "result": "#/definitions/commandResult" },
      "webapp_check": { "params": "#/definitions/emptyParams", "result": "#/definitions/commandResult" },
      "runtime_info_subscribe": { "aliases": ["subscribe_runtime_info"], "params": "#/definitions/runtimeSubscriptionParams", "result": "#/definitions/subscriptionResult" },
      "runtime_info_unsubscribe": { "aliases": ["unsubscribe_runtime_info"], "params": "#/definitions/runtimeSubscriptionParams", "result": "#/definitions/subscriptionResult" }
    },
    "events": {
      "color_event": "#/definitions/colorEventParams",
      "runtime_info": "#/definitions/runtimeInfoParams",
      "notification": "#/definitions/messageEventParams",
      "webapp_cmd": "#/definitions/messageEventParams",
      "ota_status": "#/definitions/otaStatusParams",
      "webapp_ota_status": "#/definitions/webappOtaStatusParams",
      "clock_slave_status": "#/definitions/clockSlaveStatusParams",
      "transition_finished": "#/definitions/transitionFinishedParams",
      "keep_alive": "#/definitions/emptyParams"
    },
    "errors": {
      "-32700": "Parse error",
      "-32600": "Invalid request",
      "-32601": "Method not found",
      "-32603": "Internal error",
      "-32001": "Authentication required or failed",
      "-32000": "Command failed"
    }
  },
  "notes": [
    "Inferred contracts must be promoted to stable only after fixture tests pass against firmware and frontend.",
    "The config and data operations reference app-config.cfgdb and app-data.cfgdb directly; each remains a separate persistent ConfigDB database.",
    "Generated schema projections exist only for browser and OpenAPI tooling and never replace or merge the cfgdb databases.",
    "The color RPC overload reads state for empty params and executes a command for non-empty params.",
    "Config and hosts are not currently reachable through the WebSocket handler.",
    "HTTP currently returns 400 rather than 405 for unsupported methods."
  ]
}