{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lightinator.de/schemas/json-rpc-api.schema.json",
  "title": "Lightinator wire API",
  "description": "Transient HTTP, JSON-RPC and event workspaces inferred from firmware and frontend implementations.",
  "type": "object",
  "store": false,
  "properties": {
    "request": { "$ref": "#/definitions/jsonRpcRequest" },
    "response": { "$ref": "#/definitions/jsonRpcResponse" },
    "event": { "$ref": "#/definitions/eventEnvelope" },
    "color": { "$ref": "#/definitions/colorState" },
    "colorCommand": { "$ref": "#/definitions/colorParams" },
    "animationCommand": { "$ref": "#/definitions/animationParams" },
    "info": { "$ref": "#/definitions/infoResult" },
    "networks": { "$ref": "#/definitions/networksResult" },
    "connection": { "$ref": "#/definitions/connectionResult" },
    "hosts": { "$ref": "#/definitions/hostsResult" },
    "apiResult": { "$ref": "#/definitions/apiResult" }
  },
  "definitions": {
    "emptyParams": { "type": "object", "additionalProperties": false },
    "apiSuccess": {
      "type": "object",
      "required": ["success"],
      "properties": { "success": { "type": "boolean", "const": true } },
      "additionalProperties": false
    },
    "apiError": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "type": "string" },
        "info": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "apiResult": { "oneOf": [{ "$ref": "#/definitions/apiSuccess" }, { "$ref": "#/definitions/apiError" }] },
    "commandResult": {
      "type": "object",
      "required": ["success"],
      "properties": { "success": { "type": "boolean", "const": true } },
      "additionalProperties": false
    },
    "absoluteOrRelativeValue": {
      "type": "number",
      "description": "Canonical generated value. Current firmware also accepts legacy relative-value strings, which are intentionally outside the generated contract because ConfigDB does not support scalar unions."
    },
    "rawPoint": {
      "type": "object",
      "properties": {
        "r": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "g": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "b": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "ww": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "cw": { "type": "integer", "minimum": 0, "maximum": 1023 }
      },
      "additionalProperties": false
    },
    "hsvPoint": {
      "type": "object",
      "properties": {
        "h": { "type": "number", "minimum": 0, "maximum": 359 },
        "s": { "type": "number", "minimum": 0, "maximum": 100 },
        "v": { "type": "number", "minimum": 0, "maximum": 100 },
        "ct": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "additionalProperties": false
    },
    "relativeRawPoint": {
      "type": "object",
      "properties": {
        "r": { "$ref": "#/definitions/absoluteOrRelativeValue" },
        "g": { "$ref": "#/definitions/absoluteOrRelativeValue" },
        "b": { "$ref": "#/definitions/absoluteOrRelativeValue" },
        "ww": { "$ref": "#/definitions/absoluteOrRelativeValue" },
        "cw": { "$ref": "#/definitions/absoluteOrRelativeValue" }
      },
      "additionalProperties": false
    },
    "relativeHsvPoint": {
      "type": "object",
      "properties": {
        "h": { "$ref": "#/definitions/absoluteOrRelativeValue" },
        "s": { "$ref": "#/definitions/absoluteOrRelativeValue" },
        "v": { "$ref": "#/definitions/absoluteOrRelativeValue" },
        "ct": { "$ref": "#/definitions/absoluteOrRelativeValue" }
      },
      "additionalProperties": false
    },
    "colorState": {
      "type": "object",
      "required": ["raw", "hsv"],
      "properties": {
        "raw": { "$ref": "#/definitions/rawPoint" },
        "hsv": { "$ref": "#/definitions/hsvPoint" }
      },
      "additionalProperties": false
    },
    "colorEventParams": {
      "type": "object",
      "required": ["mode", "raw"],
      "properties": {
        "mode": { "type": "string", "enum": ["raw", "hsv"] },
        "raw": { "$ref": "#/definitions/rawPoint" },
        "hsv": { "$ref": "#/definitions/hsvPoint" }
      },
      "additionalProperties": false
    },
    "commandFields": {
      "type": "object",
      "properties": {
        "cmd": { "type": "string" },
        "hsv": { "$ref": "#/definitions/relativeHsvPoint" },
        "raw": { "$ref": "#/definitions/relativeRawPoint" },
        "t": { "type": "integer", "minimum": 0 },
        "s": { "type": "integer", "minimum": 0 },
        "r": { "type": "boolean" },
        "d": { "type": "integer", "minimum": 0, "maximum": 1 },
        "name": { "type": "string" },
        "q": { "type": "string", "enum": ["back", "front", "front_reset", "single"] },
        "channels": {
          "type": "array",
          "items": { "type": "string", "enum": ["h", "s", "v", "ct", "r", "g", "b", "ww", "cw"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "colorCommand": {
      "type": "object",
      "properties": {
        "cmd": { "type": "string" },
        "hsv": { "$ref": "#/definitions/relativeHsvPoint" },
        "raw": { "$ref": "#/definitions/relativeRawPoint" },
        "t": { "type": "integer", "minimum": 0 },
        "s": { "type": "integer", "minimum": 0 },
        "r": { "type": "boolean" },
        "d": { "type": "integer", "minimum": 0, "maximum": 1 },
        "name": { "type": "string" },
        "q": { "type": "string", "enum": ["back", "front", "front_reset", "single"] },
        "channels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "anyOf": [
        { "required": ["hsv"], "properties": { "hsv": {} } },
        { "required": ["raw"], "properties": { "raw": {} } }
      ],
      "additionalProperties": false
    },
    "colorCommandList": {
      "type": "object",
      "required": ["cmds"],
      "properties": { "cmds": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/colorCommand" } } },
      "additionalProperties": false
    },
    "colorParams": { "oneOf": [{ "$ref": "#/definitions/colorCommand" }, { "$ref": "#/definitions/colorCommandList" }] },
    "animationParams": { "$ref": "#/definitions/commandFields" },
    "blinkParams": {
      "type": "object",
      "properties": {
        "ramp": { "type": "integer", "minimum": 0 },
        "q": { "type": "string", "enum": ["back", "front", "front_reset", "single"] },
        "r": { "type": "boolean" },
        "name": { "type": "string" },
        "channels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "infoParams": {
      "type": "object",
      "properties": {
        "V": { "type": "string", "enum": ["1", "2"] },
        "sparse": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "connectionInfo": {
      "type": "object",
      "required": ["connected"],
      "properties": {
        "connected": { "type": "boolean" },
        "ssid": { "type": "string" },
        "dhcp": { "type": "boolean" },
        "ip": { "type": "string" },
        "netmask": { "type": "string" },
        "gateway": { "type": "string" },
        "mac": { "type": "string" },
        "rssi": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "runtimeInfoParams": {
      "type": "object",
      "properties": {
        "uptime": { "type": "integer", "minimum": 0 },
        "heap_free": { "type": "integer", "minimum": 0 },
        "minfreeHeapRuntime": { "type": "integer", "minimum": 0 },
        "minfreeHeap10min": { "type": "integer", "minimum": 0 },
        "heapLowErrUptime": { "type": "integer", "minimum": 0 },
        "heapLowErr10min": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "infoV1Result": {
      "type": "object",
      "required": ["deviceid", "soc", "git_version", "build_type", "git_date", "webapp_version", "sming", "uptime", "heap_free", "connection"],
      "properties": {
        "deviceid": { "type": "integer", "minimum": 0 },
        "soc": { "type": "string" },
        "current_rom": { "type": "string" },
        "git_version": { "type": "string" },
        "build_type": { "type": "string" },
        "git_date": { "type": "string" },
        "webapp_version": { "type": "string" },
        "sming": { "type": "string" },
        "event_num_clients": { "type": "integer", "minimum": 0 },
        "uptime": { "type": "integer", "minimum": 0 },
        "heap_free": { "type": "integer", "minimum": 0 },
        "rgbww": { "type": "object", "additionalProperties": true },
        "connection": { "$ref": "#/definitions/connectionInfo" }
      },
      "additionalProperties": false
    },
    "infoV2Result": {
      "type": "object",
      "required": ["version", "device", "app", "sming", "filesystem", "connection", "mqtt", "homeassistant"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "device": { "type": "object", "additionalProperties": true },
        "app": { "type": "object", "additionalProperties": true },
        "sming": { "type": "object", "additionalProperties": true },
        "filesystem": { "type": "object", "additionalProperties": true },
        "runtime": { "$ref": "#/definitions/runtimeInfoParams" },
        "debug": { "type": "object", "additionalProperties": true },
        "rgbww": { "type": "object", "additionalProperties": true },
        "connection": { "$ref": "#/definitions/connectionInfo" },
        "mqtt": { "type": "object", "additionalProperties": true },
        "homeassistant": { "type": "object", "additionalProperties": true },
        "ota": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "infoResult": { "oneOf": [{ "$ref": "#/definitions/infoV1Result" }, { "$ref": "#/definitions/infoV2Result" }] },
    "networkItem": {
      "type": "object",
      "required": ["id", "ssid", "signal", "encryption"],
      "properties": {
        "id": { "type": "integer" },
        "ssid": { "type": "string" },
        "signal": { "type": "integer" },
        "encryption": { "type": "string" }
      },
      "additionalProperties": false
    },
    "networksResult": {
      "type": "object",
      "required": ["scanning"],
      "properties": {
        "scanning": { "type": "boolean" },
        "available": { "type": "array", "maxItems": 26, "items": { "$ref": "#/definitions/networkItem" } }
      },
      "additionalProperties": false
    },
    "connectParams": {
      "type": "object",
      "required": ["ssid"],
      "properties": { "ssid": { "type": "string", "minLength": 1 }, "password": { "type": "string" } },
      "additionalProperties": false
    },
    "connectionResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "integer" },
        "error": { "type": "string" },
        "ip": { "type": "string" },
        "dhcp": { "type": "string", "enum": ["True", "False"] },
        "ssid": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hostItem": {
      "type": "object",
      "required": ["id", "hostname", "ip_address", "host_type", "visible", "state"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "hostname": { "type": "string" },
        "ip_address": { "type": "string" },
        "host_type": { "type": "string", "enum": ["ALIAS", "CONTROLLER", "WALLPANEL", "UNKNOWN"] },
        "visible": { "type": "boolean" },
        "state": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "hostsResult": {
      "type": "object",
      "required": ["hosts"],
      "properties": { "hosts": { "type": "array", "items": { "$ref": "#/definitions/hostItem" } } },
      "additionalProperties": false
    },
    "systemDebugParams": {
      "type": "object",
      "required": ["cmd", "enable"],
      "properties": { "cmd": { "type": "string", "const": "debug" }, "enable": { "type": "boolean" } },
      "additionalProperties": false
    },
    "systemRestartParams": {
      "type": "object",
      "required": ["cmd"],
      "properties": { "cmd": { "type": "string", "const": "restart" }, "clearOTA": { "type": "boolean" } },
      "additionalProperties": false
    },
    "systemNamedParams": {
      "type": "object",
      "required": ["cmd"],
      "properties": { "cmd": { "type": "string", "enum": ["reset", "clear_ota_restart", "disable_ap", "forget_wifi", "forget_wifi_restart", "switch_rom", "forget_controllers"] } },
      "additionalProperties": false
    },
    "systemParams": { "oneOf": [{ "$ref": "#/definitions/systemDebugParams" }, { "$ref": "#/definitions/systemRestartParams" }, { "$ref": "#/definitions/systemNamedParams" }] },
    "updateParams": {
      "type": "object",
      "required": ["rom"],
      "properties": {
        "rom": {
          "type": "object",
          "required": ["url"],
          "properties": { "url": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "updateStatus": { "type": "object", "required": ["status"], "properties": { "status": { "type": "integer" } }, "additionalProperties": false },
    "pingResult": { "type": "object", "required": ["ping"], "properties": { "ping": { "type": "string", "const": "pong" } }, "additionalProperties": false },
    "authenticateParams": { "type": "object", "properties": { "hash": { "type": "string" } }, "additionalProperties": false },
    "authenticateResult": { "type": "object", "required": ["authenticated"], "properties": { "authenticated": { "type": "boolean", "const": true } }, "additionalProperties": false },
    "runtimeSubscriptionParams": { "type": "object", "properties": { "channel": { "type": "string", "const": "runtime_info" } }, "additionalProperties": false },
    "subscriptionResult": {
      "type": "object",
      "required": ["subscribed", "channel"],
      "properties": { "subscribed": { "type": "boolean" }, "channel": { "type": "string", "const": "runtime_info" } },
      "additionalProperties": false
    },
    "messageEventParams": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } }, "additionalProperties": false },
    "otaStatusParams": {
      "type": "object",
      "required": ["status", "message"],
      "properties": { "status": { "type": "integer" }, "message": { "type": "string" } },
      "additionalProperties": false
    },
    "webappOtaStatusParams": {
      "type": "object",
      "required": ["state", "file", "total", "last_status", "in_progress"],
      "properties": {
        "state": { "type": "string", "enum": ["idle", "querying_api", "downloading", "activating"] },
        "file": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "file_path": { "type": "string" },
        "version": { "type": "string" },
        "last_status": { "type": "string" },
        "in_progress": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "clockSlaveStatusParams": {
      "type": "object",
      "required": ["offset", "current_interval"],
      "properties": { "offset": { "type": "integer" }, "current_interval": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "transitionFinishedParams": {
      "type": "object",
      "required": ["name", "requeued"],
      "properties": { "name": { "type": "string" }, "requeued": { "type": "boolean" } },
      "additionalProperties": false
    },
    "jsonRpcError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": { "code": { "type": "integer" }, "message": { "type": "string" }, "data": { "type": "object", "additionalProperties": true } },
      "additionalProperties": false
    },
    "jsonRpcRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "integer" },
        "method": { "type": "string", "enum": ["authenticate", "info", "getInfo", "color", "getColor", "networks", "getNetworks", "stop", "skip", "pause", "continue", "blink", "toggle", "direct", "setOn", "on", "setOff", "off", "keep_alive", "scan_networks", "system", "webapp_check", "runtime_info_subscribe", "subscribe_runtime_info", "runtime_info_unsubscribe", "unsubscribe_runtime_info"] },
        "params": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "jsonRpcSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "result"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "integer" },
        "result": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "jsonRpcErrorResponse": {
      "type": "object",
      "required": ["jsonrpc", "error"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "integer" },
        "challenge": { "type": "string" },
        "error": { "$ref": "#/definitions/jsonRpcError" }
      },
      "additionalProperties": false
    },
    "jsonRpcResponse": {
      "oneOf": [
        { "$ref": "#/definitions/jsonRpcSuccessResponse" },
        { "$ref": "#/definitions/jsonRpcErrorResponse" }
      ]
    },
    "eventEnvelope": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "integer" },
        "method": { "type": "string", "enum": ["color_event", "runtime_info", "notification", "webapp_cmd", "ota_status", "webapp_ota_status", "clock_slave_status", "transition_finished", "keep_alive"] },
        "params": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  }
}