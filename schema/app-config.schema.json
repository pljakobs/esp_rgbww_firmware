{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "extensions": {
      "type": "object",
      "properties": {
        "display": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "address": {
              "type": "integer",
              "minimum": 0,
              "maximum": 119,
              "default": 0,
              "description": "7-bit I2C address; 0 uses the compiled display address"
            }
          }
        },
        "current_sensor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "address": {
              "type": "integer",
              "minimum": 64,
              "maximum": 79,
              "default": 64
            },
            "shunt_ohms": {
              "type": "number",
              "minimum": 0.00001,
              "maximum": 1,
              "default": 0.1
            },
            "interval_ms": {
              "type": "integer",
              "minimum": 200,
              "maximum": 3600000,
              "default": 1000
            }
          }
        },
        "color_sensor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "interval_ms": {
              "type": "integer",
              "minimum": 200,
              "maximum": 3600000,
              "default": 1000
            },
            "atime": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "default": 29
            },
            "astep": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "default": 599
            },
            "gain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 6,
              "description": "AS7341 gain register value"
            }
          }
        }
      }
    },
    "general": {
      "type": "object",
      "properties": {
        "is_initialized": {
          "type": "boolean",
          "default": false
        },
        "device_name": {
          "type": "string",
          "default": ""
        },
        "buttons_debounce_ms": {
          "type": "integer",
          "default": 50
        },
        "buttons_config": {
          "type": "string"
        },
        "pin_config_url": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/pljakobs/esp_rgb_webapp2/develop/public/config/pinconfig.json"
        },
        "supported_color_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "RGB",
            "RGBWW",
            "RGBCW",
            "RGBWWCW"
          ]
        },
        "current_pin_config_name": {
          "type": "string",
          "default": "mrpj"
        },
        "allow_web_icons": {
          "type": "boolean",
          "default": true
        },
        "UI": {
          "type": "object",
          "properties": {
            "dark_mode": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "ota": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "default": "http://lightinator.de/version.json"
        }
      }
    },
    "webapp": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "api_base_url": {
          "type": "string",
          "default": "http://lightinator.de/api"
        },
        "installed_version": {
          "type": "string",
          "default": ""
        },
        "installed_md5": {
          "type": "string",
          "default": ""
        },
        "last_check_status": {
          "type": "string",
          "default": ""
        },
        "in_progress": {
          "type": "boolean",
          "default": false
        },
        "current": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "default": ""
            },
            "branch": {
              "type": "string",
              "default": ""
            },
            "type": {
              "type": "string",
              "default": ""
            },
            "basepath": {
              "type": "string",
              "default": ""
            },
            "min_firmware": {
              "type": "string",
              "default": ""
            },
            "total_size": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "string",
                    "default": ""
                  },
                  "md5": {
                    "type": "string",
                    "default": ""
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  }
                }
              }
            },
            "comment": {
              "type": "string",
              "default": ""
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "api_secured": {
          "type": "boolean",
          "default": false
        },
        "api_password": {
          "type": "string"
        }
      }
    },
    "color": {
      "type": "object",
      "properties": {
        "startup_color": {
          "type": "string",
          "default": "last"
        },
        "startup": {
          "description": "modern startup color selection",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "default": "LAST",
              "enum": [
                "LAST",
                "SET"
              ]
            },
            "color": {
              "type": "string"
            }
          }
        },
        "brightness": {
          "type": "object",
          "properties": {
            "red": {
              "type": "integer",
              "default": 100
            },
            "ww": {
              "type": "integer",
              "default": 100
            },
            "green": {
              "type": "integer",
              "default": 100
            },
            "blue": {
              "type": "integer",
              "default": 100
            },
            "cw": {
              "type": "integer",
              "default": 100
            }
          }
        },
        "colortemp": {
          "type": "object",
          "properties": {
            "ww": {
              "type": "integer",
              "default": 2700
            },
            "cw": {
              "type": "integer",
              "default": 6000
            }
          }
        },
        "color_mode": {
          "type": "integer",
          "default": 0
        },
        "hsv": {
          "type": "object",
          "properties": {
            "red": {
              "type": "integer",
              "default": 0
            },
            "magenta": {
              "type": "integer",
              "default": 0
            },
            "green": {
              "type": "integer",
              "default": 0
            },
            "blue": {
              "type": "integer",
              "default": 0
            },
            "yellow": {
              "type": "integer",
              "default": 0
            },
            "model": {
              "type": "integer",
              "default": 0
            },
            "cyan": {
              "type": "integer",
              "default": 0
            }
          }
        },
        "calibration": {
          "type": "object",
          "properties": {
            "gamma": {
              "type": "number",
              "description": "System output gamma for correction calculation (e.g. 2.2)"
            },
            "ct_range": {
              "type": "object",
              "description": "Kelvin range normalization bounds",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1000,
                  "default": 1000
                },
                "max": {
                  "type": "integer",
                  "maximum": 20000,
                  "default": 20000
                }
              }
            },
            "hsv": {
              "type": "array",
              "description": "12 Parabolic coefficients for 30-degree Hue sectors (0, 30, ... 330)",
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "$ref": "#/definitions/parabola"
              }
            },
            "ct": {
              "description": "Parabolic coefficients for Color Temperature curve",
              "$ref": "#/definitions/parabola"
            }
          }
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "cmd_master_enabled": {
          "type": "boolean",
          "default": false
        },
        "color_slave_enabled": {
          "type": "boolean",
          "default": false
        },
        "color_slave_topic": {
          "type": "string",
          "default": "home/led1/command"
        },
        "clock_master_enabled": {
          "type": "boolean",
          "default": false
        },
        "color_master_interval_ms": {
          "type": "integer",
          "default": 0
        },
        "clock_slave_enabled": {
          "type": "boolean",
          "default": false
        },
        "cmd_slave_enabled": {
          "type": "boolean",
          "default": false
        },
        "clock_master_interval": {
          "type": "integer",
          "default": 30
        },
        "clock_slave_topic": {
          "type": "string",
          "default": "home/led1/clock"
        },
        "cmd_slave_topic": {
          "type": "string",
          "default": "home/led/command"
        },
        "color_master_enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "color_interval_ms": {
          "type": "integer",
          "default": 500
        },
        "color_min_interval_ms": {
          "type": "integer",
          "default": 500
        },
        "trans_fin_interval_ms": {
          "type": "integer",
          "default": 1000
        },
        "server_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "mqtt": {
          "type": "object",
          "properties": {
            "server": {
              "type": "string",
              "default": "mqtt.local"
            },
            "password": {
              "type": "string",
              "default": ""
            },
            "port": {
              "type": "integer",
              "default": 1883
            },
            "topic_base": {
              "type": "string",
              "default": "home/"
            },
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "username": {
              "type": "string",
              "default": ""
            },
            "homeassistant": {
              "type": "object",
              "properties": {
                "enable": {
                  "type": "boolean",
                  "default": true
                },
                "discovery_prefix": {
                  "type": "string",
                  "default": "homeassistant"
                },
                "node_id": {
                  "type": "string",
                  "default": ""
                }
              }
            }
          }
        },
        "ntp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "server": {
              "type": "string",
              "default": "pool.ntp.org"
            },
            "interval": {
              "type": "integer",
              "default": 3600
            }
          }
        },
        "connection": {
          "type": "object",
          "properties": {
            "netmask": {
              "type": "string",
              "default": "255.255.255.0"
            },
            "ip": {
              "type": "string",
              "default": "192.168.1.1"
            },
            "dhcp": {
              "type": "boolean",
              "default": true
            },
            "gateway": {
              "type": "string",
              "default": "192.168.1.255"
            }
          }
        },
        "ap": {
          "type": "object",
          "properties": {
            "password": {
              "type": "string",
              "default": "configesp"
            },
            "secured": {
              "type": "boolean",
              "default": true
            },
            "ssid": {
              "type": "string"
            }
          }
        },
        "mdns": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "name": {
              "type": "string"
            }
          }
        },
        "rsyslog": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "default": 514
            }
          }
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "statsEnabled": {
              "type": "boolean"
            },
            "logEnabled": {
              "type": "boolean",
              "default": false
            },
            "url": {
              "type": "string",
              "default": "lightinator.de:1883"
            },
            "user": {
              "type": "string",
              "default": "rgbww"
            },
            "password": {
              "type": "string",
              "default": "rgbwwdebug"
            },
            "numReboots": {
              "type": "integer",
              "default": 0
            }
          }
        }
      }
    },
    "hardware": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 4,
          "default": 4
        },
        "version": {
          "type": "integer",
          "default": 0
        },
        "pwm": {
          "type": "object",
          "properties": {
            "timer": {
              "type": "object",
              "properties": {
                "speed_mode": {
                  "type": "string",
                  "default": "LOWSPEED",
                  "enum": [
                    "LOWSPEED",
                    "HIGHSPEED"
                  ]
                },
                "frequency": {
                  "type": "integer",
                  "default": 1000
                },
                "resolution": {
                  "type": "integer",
                  "default": 10,
                  "minimum": 1,
                  "maximum": 14
                },
                "number": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 3
                }
              }
            },
            "spreadSpectrum": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "default": "ON",
                  "enum": [
                    "ON",
                    "OFF"
                  ]
                },
                "width": {
                  "type": "integer",
                  "default": 15
                },
                "subsampling": {
                  "type": "integer",
                  "default": 4
                }
              }
            },
            "phaseShift": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "default": "ON",
                  "enum": [
                    "ON",
                    "OFF"
                  ]
                }
              }
            }
          }
        },
        "available_pins": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "soc",
              "pins"
            ],
            "properties": {
              "soc": {
                "type": "string",
                "pattern": "^(esp32|esp32c3)$"
              },
              "pins": {
                "type": "array",
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "gpio",
                    "capability"
                  ],
                  "properties": {
                    "gpio": {
                      "$ref": "#/definitions/pin"
                    },
                    "capability": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 127,
                      "description": "Bit mask: input=1, output=2, pwm=4, strapping=8, pull_up=16, pull_down=32, reserved=64."
                    }
                  }
                }
              }
            }
          }
        },
        "boards": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/board_profile"
          }
        },
        "templates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/hardware_template"
          }
        },
        "configuration": {
          "$ref": "#/definitions/hardware_configuration"
        }
      }
    }
  },
  "definitions": {
    "color_settings": {
      "type": "object",
      "properties": {
        "startup_color": {
          "type": "string",
          "default": "last"
        },
        "startup": {
          "$ref": "#/definitions/light_color_startup"
        },
        "brightness": {
          "$ref": "#/definitions/light_color_brightness"
        },
        "colortemp": {
          "$ref": "#/definitions/light_color_colortemp"
        },
        "hsv": {
          "$ref": "#/definitions/light_color_hsv"
        },
        "calibration": {
          "$ref": "#/definitions/light_color_calibration"
        }
      }
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "raw": {
      "type": "object",
      "properties": {
        "ww": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "cw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        }
      }
    },
    "hsv": {
      "type": "object",
      "properties": {
        "s": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "v": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "h": {
          "type": "number",
          "minimum": 0,
          "maximum": 359
        },
        "ct": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 0
        }
      }
    },
    "hsvct": {
      "type": "object",
      "properties": {
        "s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "v": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "h": {
          "type": "integer",
          "minimum": 0,
          "maximum": 359
        },
        "ct": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 0
        }
      }
    },
    "Preset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "color": {
      "oneOf": [
        {
          "$ref": "#/definitions/hsv"
        },
        {
          "$ref": "#/definitions/hsvct"
        },
        {
          "$ref": "#/definitions/raw"
        },
        {
          "$ref": "#/definitions/Preset"
        }
      ]
    },
    "pin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "channel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "pin": {
          "$ref": "#/definitions/pin"
        }
      }
    },
    "parabola": {
      "type": "object",
      "required": [
        "a",
        "b",
        "c"
      ],
      "properties": {
        "a": {
          "type": "number",
          "description": "Quadratic term"
        },
        "b": {
          "type": "number",
          "description": "Linear term"
        },
        "c": {
          "type": "number",
          "description": "Constant term"
        }
      }
    },
    "light_color_startup": {
      "description": "modern startup color selection",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "default": "LAST",
          "pattern": "^(LAST|SET)$"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "light_color_brightness": {
      "type": "object",
      "properties": {
        "red": {
          "type": "integer",
          "default": 100
        },
        "ww": {
          "type": "integer",
          "default": 100
        },
        "green": {
          "type": "integer",
          "default": 100
        },
        "blue": {
          "type": "integer",
          "default": 100
        },
        "cw": {
          "type": "integer",
          "default": 100
        }
      }
    },
    "light_color_colortemp": {
      "type": "object",
      "properties": {
        "ww": {
          "type": "integer",
          "default": 2700
        },
        "cw": {
          "type": "integer",
          "default": 6000
        }
      }
    },
    "light_color_hsv": {
      "type": "object",
      "properties": {
        "red": {
          "type": "integer",
          "default": 0
        },
        "magenta": {
          "type": "integer",
          "default": 0
        },
        "green": {
          "type": "integer",
          "default": 0
        },
        "blue": {
          "type": "integer",
          "default": 0
        },
        "yellow": {
          "type": "integer",
          "default": 0
        },
        "model": {
          "type": "integer",
          "default": 0
        },
        "cyan": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "light_color_calibration_ct_range": {
      "type": "object",
      "description": "Kelvin range normalization bounds",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1000,
          "default": 1000
        },
        "max": {
          "type": "integer",
          "maximum": 20000,
          "default": 20000
        }
      }
    },
    "light_color_calibration_hsv": {
      "type": "array",
      "description": "12 Parabolic coefficients for 30-degree Hue sectors (0, 30, ... 330)",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/parabola"
      }
    },
    "light_color_calibration": {
      "type": "object",
      "properties": {
        "gamma": {
          "type": "number",
          "description": "System output gamma for correction calculation (e.g. 2.2)"
        },
        "ct_range": {
          "$ref": "#/definitions/light_color_calibration_ct_range"
        },
        "hsv": {
          "$ref": "#/definitions/light_color_calibration_hsv"
        },
        "ct": {
          "description": "Parabolic coefficients for Color Temperature curve",
          "$ref": "#/definitions/parabola"
        }
      }
    },
    "board_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gpio",
        "label",
        "allowed_functions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "gpio": {
          "$ref": "#/definitions/pin"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "aliases": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 32
          }
        },
        "allowed_functions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(light\\.pwm|button\\.input|system\\.clear_config|i2c\\.sda|i2c\\.scl|digital\\.data|digital\\.relay)$"
          }
