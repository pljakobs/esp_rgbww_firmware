{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sync-lock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "default": ""
        },
        "ts": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "last-color": {
      "$ref": "#/definitions/hsvct"
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "d": {
              "type": "integer"
            },
            "t": {
              "type": "integer"
            },
            "s": {
              "type": "integer"
            },
            "cmd": {
              "type": "string"
            },
            "q": {
              "type": "string"
            },
            "$ref": "#/definitions/color"
          },
          "id": {
            "type": "string"
          },
          "favorite": {
            "type": "boolean",
            "default": false
          },
          "light_favorites": {
            "description": "Per-light UUID favorite overrides. Missing entries use favorite only for the default light.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "light_id": {
                  "type": "string"
                },
                "favorite": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "light_id",
                "favorite"
              ]
            }
          },
          "raw_channels": {
            "description": "Indexed RAW values for a preset with matching light_type; empty uses color instead.",
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            }
          },
          "light_type": {
            "description": "Source output profile for indexed RAW presets.",
            "type": "string"
          },
          "ts": {
            "type": "integer"
          },
          "icon": {
            "type": "string",
            "default": "palette"
          }
        }
      }
    },
    "controllers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ip-address": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "default": "led-strip-variant"
          }
        },
        "required": [
          "id",
          "name",
          "ip-address"
        ]
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ts": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "default": "light_groups"
          },
          "controller_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ts": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "group_id": {
            "type": "string"
          },
          "favorite": {
            "type": "boolean",
            "default": false
          },
          "icon": {
            "type": "string",
            "default": "scene"
          },
          "transition": {
            "type": "object",
            "properties": {
              "d": {
                "type": "integer"
              },
              "t": {
                "type": "integer"
              },
              "s": {
                "type": "integer"
              },
              "cmd": {
                "type": "string"
              },
              "q": {
                "type": "string"
              },
              "r": {
                "type": "boolean"
              }
            }
          },
          "settings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "controller_id": {
                  "type": "string"
                },
                "light": {
                  "description": "Controller-local API index. -1 preserves legacy default-light targeting.",
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 65535,
                  "default": -1
                },
                "light_id": {
                  "description": "Persistent light UUID. Clients resolve its current index before playback.",
                  "type": "string",
                  "default": ""
                },
                "pos": {
                  "type": "integer"
                },
                "transition": {
                  "type": "object",
                  "properties": {
                    "d": {
                      "type": "integer"
                    },
                    "t": {
                      "type": "integer"
                    },
                    "s": {
                      "type": "integer"
                    },
                    "cmd": {
                      "type": "string"
                    },
                    "q": {
                      "type": "string"
                    },
                    "r": {
                      "type": "boolean"
                    }
                  }
                },
                "color": {
                  "oneOf": [
                    {
                      "$ref": "#/definitions/Preset"
                    },
                    {
                      "$ref": "#/definitions/hsv"
                    },
                    {
                      "$ref": "#/definitions/hsvct"
                    },
                    {
                      "$ref": "#/definitions/raw"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "color_settings": {
      "type": "object",
      "properties": {
        "startup_color": {
          "type": "string",
          "default": "last"
        },
        "startup": {
          "$ref": "#/definitions/light_color_startup"
        },
        "brightness": {
          "$ref": "#/definitions/light_color_brightness"
        },
        "colortemp": {
          "$ref": "#/definitions/light_color_colortemp"
        },
        "hsv": {
          "$ref": "#/definitions/light_color_hsv"
        },
        "calibration": {
          "$ref": "#/definitions/light_color_calibration"
        }
      }
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "raw": {
      "type": "object",
      "properties": {
        "ww": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "cw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        }
      }
    },
    "hsv": {
      "type": "object",
      "properties": {
        "s": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "v": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "h": {
          "type": "number",
          "minimum": 0,
          "maximum": 359
        },
        "ct": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 0
        }
      }
    },
    "hsvct": {
      "type": "object",
      "properties": {
        "s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "v": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "h": {
          "type": "integer",
          "minimum": 0,
          "maximum": 359
        },
        "ct": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 0
        }
      }
    },
    "Preset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "color": {
      "oneOf": [
        {
          "$ref": "#/definitions/hsv"
        },
        {
          "$ref": "#/definitions/hsvct"
        },
        {
          "$ref": "#/definitions/raw"
        },
        {
          "$ref": "#/definitions/Preset"
        }
      ]
    },
    "pin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "channel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "pin": {
          "$ref": "#/definitions/pin"
        }
      }
    },
    "parabola": {
      "type": "object",
      "required": [
        "a",
        "b",
        "c"
      ],
      "properties": {
        "a": {
          "type": "number",
          "description": "Quadratic term"
        },
        "b": {
          "type": "number",
          "description": "Linear term"
        },
        "c": {
          "type": "number",
          "description": "Constant term"
        }
      }
    },
    "light_color_startup": {
      "description": "modern startup color selection",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "default": "LAST",
          "pattern": "^(LAST|SET)$"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "light_color_brightness": {
      "type": "object",
      "properties": {
        "red": {
          "type": "integer",
          "default": 100
        },
        "ww": {
          "type": "integer",
          "default": 100
        },
        "green": {
          "type": "integer",
          "default": 100
        },
        "blue": {
          "type": "integer",
          "default": 100
        },
        "cw": {
          "type": "integer",
          "default": 100
        }
      }
    },
    "light_color_colortemp": {
      "type": "object",
      "properties": {
        "ww": {
          "type": "integer",
          "default": 2700
        },
        "cw": {
          "type": "integer",
          "default": 6000
        }
      }
    },
    "light_color_hsv": {
      "type": "object",
      "properties": {
        "red": {
          "type": "integer",
          "default": 0
        },
        "magenta": {
          "type": "integer",
          "default": 0
        },
        "green": {
          "type": "integer",
          "default": 0
        },
        "blue": {
          "type": "integer",
          "default": 0
        },
        "yellow": {
          "type": "integer",
          "default": 0
        },
        "model": {
          "type": "integer",
          "default": 0
        },
        "cyan": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "light_color_calibration_ct_range": {
      "type": "object",
      "description": "Kelvin range normalization bounds",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1000,
          "default": 1000
        },
        "max": {
          "type": "integer",
          "maximum": 20000,
          "default": 20000
        }
      }
    },
    "light_color_calibration_hsv": {
      "type": "array",
      "description": "12 Parabolic coefficients for 30-degree Hue sectors (0, 30, ... 330)",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/parabola"
      }
    },
    "light_color_calibration": {
      "type": "object",
      "properties": {
        "gamma": {
          "type": "number",
          "description": "System output gamma for correction calculation (e.g. 2.2)"
        },
        "ct_range": {
          "$ref": "#/definitions/light_color_calibration_ct_range"
        },
        "hsv": {
          "$ref": "#/definitions/light_color_calibration_hsv"
        },
        "ct": {
          "description": "Parabolic coefficients for Color Temperature curve",
          "$ref": "#/definitions/parabola"
        }
      }
    }
  },
  "$id": "https://lightinator.de/schemas/app-data.schema.json",
  "title": "Lightinator persistent application data",
  "$comment": "Generated projection of app-data.cfgdb; app-data.cfgdb remains the authoritative AppData ConfigDB schema.",
  "x-configdb-source": "app-data.cfgdb",
  "x-configdb-database": "AppData"
}
