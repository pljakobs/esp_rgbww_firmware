{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sync-lock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "default": ""
        },
        "ts": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "last-color": {
      "$ref": "#/definitions/hsvct"
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "d": {
              "type": "integer"
            },
            "t": {
              "type": "integer"
            },
            "s": {
              "type": "integer"
            },
            "cmd": {
              "type": "string"
            },
            "q": {
              "type": "string"
            },
            "$ref": "#/definitions/color"
          },
          "id": {
            "type": "string"
          },
          "favorite": {
            "type": "boolean",
            "default": false
          },
          "ts": {
            "type": "integer"
          },
          "icon": {
            "type": "string",
            "default": "palette"
          }
        }
      }
    },
    "controllers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ip-address": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "default": "led-strip-variant"
          }
        },
        "required": [
          "id",
          "name",
          "ip-address"
        ]
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ts": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "default": "light_groups"
          },
          "controller_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ts": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "group_id": {
            "type": "string"
          },
          "favorite": {
            "type": "boolean",
            "default": false
          },
          "icon": {
            "type": "string",
            "default": "scene"
          },
          "transition": {
            "type": "object",
            "properties": {
              "d": {
                "type": "integer"
              },
              "t": {
                "type": "integer"
              },
              "s": {
                "type": "integer"
              },
              "cmd": {
                "type": "string"
              },
              "q": {
                "type": "string"
              },
              "r": {
                "type": "boolean"
              }
            }
          },
          "settings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "controller_id": {
                  "type": "string"
                },
                "pos": {
                  "type": "integer"
                },
                "transition": {
                  "type": "object",
                  "properties": {
                    "d": {
                      "type": "integer"
                    },
                    "t": {
                      "type": "integer"
                    },
                    "s": {
                      "type": "integer"
                    },
                    "cmd": {
                      "type": "string"
                    },
                    "q": {
                      "type": "string"
                    },
                    "r": {
                      "type": "boolean"
                    }
                  }
                },
                "color": {
                  "oneOf": [
                    {
                      "$ref": "#/definitions/Preset"
                    },
                    {
                      "$ref": "#/definitions/hsv"
                    },
                    {
                      "$ref": "#/definitions/hsvct"
                    },
                    {
                      "$ref": "#/definitions/raw"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "raw": {
      "type": "object",
      "properties": {
        "ww": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "cw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        }
      }
    },
    "hsv": {
      "type": "object",
      "properties": {
        "s": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "v": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "h": {
          "type": "number",
          "minimum": 0,
          "maximum": 359
        },
        "ct": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 0
        }
      }
    },
    "hsvct": {
      "type": "object",
      "properties": {
        "s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "v": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "h": {
          "type": "integer",
          "minimum": 0,
          "maximum": 359
        },
        "ct": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 0
        }
      }
    },
    "Preset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "color": {
      "oneOf": [
        {
          "$ref": "#/definitions/hsv"
        },
        {
          "$ref": "#/definitions/hsvct"
        },
        {
          "$ref": "#/definitions/raw"
        },
        {
          "$ref": "#/definitions/Preset"
        }
      ]
    },
    "pin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "channel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "pin": {
          "$ref": "#/definitions/pin"
        }
      }
    },
    "parabola": {
      "type": "object",
      "required": [
        "a",
        "b",
        "c"
      ],
      "properties": {
        "a": {
          "type": "number",
          "description": "Quadratic term"
        },
        "b": {
          "type": "number",
          "description": "Linear term"
        },
        "c": {
          "type": "number",
          "description": "Constant term"
        }
      }
    }
  },
  "$id": "https://lightinator.de/schemas/app-data.schema.json",
  "title": "Lightinator persistent application data",
  "$comment": "Generated projection of app-data.cfgdb; app-data.cfgdb remains the authoritative AppData ConfigDB schema.",
  "x-configdb-source": "app-data.cfgdb",
  "x-configdb-database": "AppData"
}
