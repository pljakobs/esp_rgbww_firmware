{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lightinator.de/schemas/api-manifest.schema.json",
  "title": "Lightinator API manifest",
  "type": "object",
  "required": ["name", "version", "status", "schemas", "http", "jsonRpc"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["inferred", "stable", "deprecated"] },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "schemas": {
      "type": "object",
      "required": ["wire", "config", "data", "http"],
      "additionalProperties": { "$ref": "#/definitions/schemaArtifact" }
    },
    "http": {
      "type": "object",
      "required": ["security", "operations"],
      "properties": {
        "security": { "type": "string" },
        "operations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/httpOperation" }
        }
      },
      "additionalProperties": false
    },
    "jsonRpc": {
      "type": "object",
      "required": ["url", "version", "methods", "events", "errors"],
      "properties": {
        "url": { "type": "string", "pattern": "^/" },
        "version": { "const": "2.0" },
        "methods": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/rpcMethod" }
        },
        "events": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/schemaRef" }
        },
        "errors": {
          "type": "object",
          "patternProperties": {
            "^-?[0-9]+$": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "schemaArtifact": {
      "type": "object",
      "required": ["source", "persistent"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "projection": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "persistent": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1
    },
    "httpOperation": {
      "type": "object",
      "required": ["method", "path", "result"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "params": { "$ref": "#/definitions/schemaRef" },
        "result": { "$ref": "#/definitions/schemaRef" }
      },
      "additionalProperties": false
    },
    "rpcMethod": {
      "type": "object",
      "required": ["params", "result"],
      "properties": {
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "params": { "$ref": "#/definitions/schemaRef" },
        "result": { "$ref": "#/definitions/schemaRef" },
        "authentication": { "type": "boolean" },
        "overload": {
          "type": "object",
          "required": ["emptyParamsResult"],
          "properties": {
            "emptyParamsResult": { "$ref": "#/definitions/schemaRef" },
            "aliases": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}