{
  "type": "object",
  "store": true,
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "interval_ms": { "type": "integer", "minimum": 200, "maximum": 3600000, "default": 1000 },
    "atime": { "type": "integer", "minimum": 0, "maximum": 255, "default": 29 },
    "astep": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 599 },
    "gain": { "type": "integer", "minimum": 0, "maximum": 10, "default": 6 }
  }
}
